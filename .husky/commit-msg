# Быстрая локальная проверка формата сообщения. Итоговое слово за CI:
# job commitlint проверяет весь диапазон коммитов, и обойти его нельзя.
#
# Если node недоступен, коммит не блокируется. Иначе разработчик без
# установленных зависимостей не смог бы закоммитить вообще ничего —
# включая правку, которая эти зависимости и чинит.
# Проверяем именно node, а не npx: husky добавляет node_modules/.bin в PATH,
# и npx оттуда находится всегда — но падает с кодом 127, потому что его
# shebang зовёт отсутствующий node.
if ! command -v node >/dev/null 2>&1; then
  echo "husky: node не найден — проверка формата пропущена, её выполнит CI" >&2
  exit 0
fi

npx --no -- commitlint --edit "$1"
