NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=postgres://autoscaler:autoscaler@localhost:5432/autoscaler
AGENT_TOKEN=change-me
POLICY_FILE=./infra/policy.example.yaml
PROXMOX_DRY_RUN=true
PROXMOX_BASE_URL=https://proxmox.example.com:8006
PROXMOX_TOKEN_ID=pve-vm-autoscaler@pve!pve-vm-autoscaler
PROXMOX_TOKEN_SECRET=change-me
PROXMOX_TLS_REJECT_UNAUTHORIZED=true

AGENT_NODE_ID=local-dev-node
AGENT_SERVER_URL=http://localhost:8080
AGENT_INTERVAL_MS=10000
AGENT_LABELS=role=worker,env=dev
